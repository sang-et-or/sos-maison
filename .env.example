# Copier en .env.local (développement) ou dans les variables d'environnement Vercel.
# Aucune de ces valeurs ne doit être exposée au navigateur.

# Base PostgreSQL (Supabase : Project Settings > Database > Connection string, mode "Transaction")
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sos_maison

# Adresse publique du site (utilisée dans les liens de connexion)
APP_URL=http://localhost:3000

# IA (https://platform.claude.com)
ANTHROPIC_API_KEY=
# Recherche de tutoriels (https://api-dashboard.search.brave.com)
BRAVE_API_KEY=

# Envoi des e-mails de connexion (https://resend.com). Vide en développement : le lien s'affiche dans la console.
RESEND_API_KEY=
EMAIL_FROM="SOS Maison <connexion@votre-domaine.fr>"

# Comptes administrateurs (e-mails séparés par des virgules)
ADMIN_EMAILS=

# Recherche Google des artisans (Google Cloud : Places API (New), clé restreinte à cette API)
GOOGLE_MAPS_API_KEY=

# Tâche planifiée de purge des photos (une longue suite de caractères au hasard)
CRON_SECRET=

# Paiements (https://dashboard.stripe.com) — facultatif : sans ces clés, le bouton Premium affiche « Bientôt disponible ».
STRIPE_SECRET_KEY=
# Developers > Webhooks > adresse https://VOTRE-SITE/api/billing/webhook
# événements : checkout.session.completed, customer.subscription.created, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
